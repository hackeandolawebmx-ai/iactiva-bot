# Copia este archivo a .env (local) y configura las mismas variables en Vercel. Nunca subas .env al repo.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Meta / WhatsApp Cloud API ---
# App secret de la app de Meta (valida X-Hub-Signature-256)
META_APP_SECRET=
# Texto cualquiera que tu pones tambien en Meta al configurar el webhook
META_VERIFY_TOKEN=
# Token de usuario del sistema (permisos whatsapp_business_messaging y whatsapp_business_management)
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v23.0

# --- Supabase (proyecto nuevo de iactiva-bot). Sin estas dos variables los datos viven en memoria ---
# La service role key (o "secret key") esta en Supabase > Project Settings > API keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel y laboratorio web (hito 4) ---
ADMIN_KEY=
